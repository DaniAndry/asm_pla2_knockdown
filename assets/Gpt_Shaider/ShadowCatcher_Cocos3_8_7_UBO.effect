CCEffect %{
  techniques:
  - name: shadow-catcher
    passes:
    - vert: shadow-catcher-vs
      frag: shadow-catcher-fs
      phase: forward
      properties: &props
        shadowColor:
          value: [0.0, 0.0, 0.0, 0.65]

      depthStencilState:
        depthTest: true
        depthWrite: false

      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
}%

CCProgram shared-ubos %{
  uniform Constants {
    vec4 shadowColor;
  };
}%

CCProgram shadow-catcher-vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>
  #include <shared-ubos>

  in vec3 a_position;

  void main () {
    gl_Position =
      cc_matProj *
      cc_matView *
      cc_matWorld *
      vec4(a_position, 1.0);
  }
}%

CCProgram shadow-catcher-fs %{
  precision highp float;

  #include <shared-ubos>

  layout(location = 0) out vec4 fragColor;

  void main () {

    // Temporary output.
    // Shadow factor should be connected through
    // Cocos 3.8.7 render-to-scene shadow chunks.

    fragColor = vec4(
      shadowColor.rgb,
      shadowColor.a
    );
  }
}%
